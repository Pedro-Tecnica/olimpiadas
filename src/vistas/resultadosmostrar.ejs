<h1>Resultados Registrados</h1>

<table border="1">
    <thead>
        <tr>
            <th>ID</th>
            <th>ID Atleta</th>
            <th>ID Evento</th>
            <th>Edición</th>
            <th>Medalla</th>
        </tr>
    </thead>
    <tbody>
        <% for (const resultado of registros) { %>
            <tr>
                <td><%= resultado.idParticipacion %></td>
                <td><%= resultado.idAtleta %></td>
                <td><%= resultado.idEvento %></td>
                <td><%= resultado.edicion %></td>
                <td><%= resultado.medalla %></td>
            </tr>
        <% } %>
    </tbody>
</table>

<br>
<a href="/resultados">Volver a resultados</a>