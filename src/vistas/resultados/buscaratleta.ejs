<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <title>Olimpiadas</title>
</head>
<body>

<div class="contenedor">
        <img src="/img/i.png" class="banner">
        <h1 class="tituloInicio">Atletas Buscar</h1>
        <a href="/"><img src="/img/LogoOli.png" alt="Logo de las Olimpiadas" class="logo"></a>


<h1>Buscar Participaciones de un Atleta</h1>
<a href="/resultados">Volver a resultados</a>
<br><br>

<form action="/resultado/buscaratleta" method="POST">
    <label>Ingresá el ID del Atleta:</label>
    <input type="number" name="idhtml" required>
    <button type="submit">Buscar</button>
</form>

<hr>

<% if (typeof registros !== 'undefined') { %>
    
    <h2>Resultados para el Atleta ID: <%= idAtleta %></h2>

    <% if (registros.length > 0) { %>
        <table border="1">
            <thead>
                <tr>
                    <th>Atleta</th>
                    <th>Evento</th>
                    <th>Edición</th>
                    <th>Medalla</th>
                </tr>
            </thead>
            <tbody>
                <% for (const fila of registros) { %>
                    <tr>
                        <td><%= fila.atleta %></td>
                        <td><%= fila.evento %></td>
                        <td><%= fila.edicion %></td>
                        <!-- Si no tiene medalla, mostramos "Sin medalla" -->
                        <td><%= fila.medalla ? fila.medalla : 'Sin medalla' %></td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    <% } else { %>
        <p style="color: red;">No se encontraron participaciones para ese atleta.</p>
    <% } %>

<% } %>