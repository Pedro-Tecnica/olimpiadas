<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <title>Olimpiadas</title>
</head>
<body>

<div class="contenedor">
        <img src="/img/i.png" class="banner">
        <h1 class="tituloInicio">Modificar Resultados</h1>
        <a href="/"><img src="/img/LogoOli.png" alt="Logo de las Olimpiadas" class="logo"></a>


<h1>Modificar Resultado</h1>
<a href="/resultados">Volver a resultados</a>
<br><br>

<form action="/resultado/modificar" method="POST">
    <label>ID de la Participación a modificar:</label>
    <input type="number" name="idhtml" required><br><br>

    <label>Nuevo ID del Atleta:</label>
    <input type="number" name="atletahtml" required><br><br>

    <label>Nuevo ID del Evento:</label>
    <input type="number" name="eventohtml" required><br><br>

    <label>Nueva Edición (ej: Tokio 2020):</label>
    <input type="text" name="edicionhtml" required><br><br>

    <label>Nueva Medalla (Oro, Plata, Bronce o NULL):</label>
    <input type="text" name="medallahtml"><br><br>

    <button type="submit">Modificar Resultado</button>
</form>