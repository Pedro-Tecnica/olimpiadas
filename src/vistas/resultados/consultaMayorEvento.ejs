<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <title>Evento con más participantes</title>
</head>
<body>
    <div class="contenedor">
        <img src="/img/i.png" class="banner">
        <h1 class="tituloInicio">Evento con más participantes</h1>
        <a href="/"><img src="/img/LogoOli.png" alt="Logo de las Olimpiadas" class="logo"></a>

        <h2>Edición más reciente</h2>
        <table border="1">
            <thead>
                <tr>
                    <th>Evento</th>
                    <th>Edición</th>
                    <th>Participantes</th>
                </tr>
            </thead>
            <tbody>
                <% for (const fila of registros) { %>
                    <tr>
                        <td><%= fila.evento %></td>
                        <td><%= fila.edicion %></td>
                        <td><%= fila.participantes %></td>
                    </tr>
                <% } %>
            </tbody>
        </table>
        <br>
        <a href="/resultado/resultadoscons">Volver a consultas</a>
    </div>
</body>
</html>
