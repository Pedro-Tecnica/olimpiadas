<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <title>Olimpiadas</title>
</head>
<body>

<div class="contenedor">
        <img src="/img/i.png" class="banner">
        <h1 class="tituloInicio">Resultados Registrados</h1>
        <a href="/"><img src="/img/LogoOli.png" alt="Logo de las Olimpiadas" class="logo"></a>


<h1>Resultados Registrados</h1>

<div class="tabla">
<table border="1">
    <thead>
        <tr>
            <th>ID</th>
            <th>Atleta</th>
            <th>Evento</th>
            <th>Edición</th>
            <th>Medalla</th>
        </tr>
    </thead>
    <tbody>
        <% for (const resultado of registros) { %>
            <tr>
                <td><%= resultado.idParticipacion %></td>
               <td><%= resultado.nombre_atleta %></td> 
                <td><%= resultado.nombre_evento %></td>
                <td><%= resultado.edicion %></td>
                <td><%= resultado.medalla %></td>
            </tr>
        <% } %>
    </tbody>
</table>
</div>

<br>
<a href="/resultados">Volver a resultados</a>