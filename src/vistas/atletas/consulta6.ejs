<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <title>Olimpiadas</title>
</head>
<body>

    <div class="contenedor">
        <img src="/img/i.png" class="banner">
        <h1 class="tituloInicio">Todos Los Atletas</h1>
        <a href="/"><img src="/img/LogoOli.png" alt="Logo de las Olimpiadas" class="logo"></a>
        

<h2>Total de Atletas por País</h2>
<table border="1">
    <thead>
        <tr>
            <th>Código de País</th>
            <th>Total de Atletas</th>
        </tr>
    </thead>
    <tbody>
        <% for (const fila of registros) { %>
            <tr>
                <td><%= fila.codigoISO %></td>
                <td><%= fila.total %></td>
            </tr>
        <% } %>
    </tbody>
</table>
<br>
<a href="/atletas/consultas">Volver a consultas</a>