<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <title>Olimpiadas</title>
</head>
<body>

    <div class="contenedor">
        <img src="/img/i.png" class="banner">
        <h1 class="tituloInicio">Todos Los Atletas</h1>
        <a href="/"><img src="/img/LogoOli.png" alt="Logo de las Olimpiadas" class="logo"></a>



<h1>Atletas registrados</h1>


<table border="1">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Género</th>
            <th>Edad</th>
            <th>Altura</th>
            <th>Peso</th>
            <th>País</th>
        </tr>
    </thead>
    <tbody>
        <% for (const atleta of registros) { %>
            <tr>
                <td><%= atleta.idAtletas %></td>
                <td><%= atleta.nombre %></td>
                <td><%= atleta.genero %></td>
                <td><%= atleta.edad %></td>
                <td><%= atleta.altura %></td>
                <td><%= atleta.peso %></td>
                 <td><%= atleta.codigoISO %></td> 
            </tr>
        <% } %>
    </tbody>
</table>

<br>
<a href="/atletas">Volver a atletas</a>
