<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <title>Olimpiadas</title>
</head>
<body>

<div class="contenedor">
        <img src="/img/i.png" class="banner">
        <h1 class="tituloInicio">Añadir Atletas</h1>
        <a href="/"><img src="/img/LogoOli.png" alt="Logo de las Olimpiadas" class="logo"></a>


<h1>Alta de atletas</h1>
<a href="/atletas">Volver a atletas</a>

<br><br>
<div class="formu">
<form action="/atletas/altasalta" method="POST">
    <label>ID:</label>
    <input type="number" name="idhtml" required><br><br>

    <label>Nombre:</label>
    <input type="text" name="nomhtml" required><br><br>

    <label>Género:</label>
    <input type="text" name="generohtml" required><br><br>

    <label>Edad:</label>
    <input type="number" name="edadhtml" required><br><br>

    <label>Altura:</label>
    <input type="number" step="0.01" name="alturahtml" required><br><br>

    <label>Peso:</label>
    <input type="number" step="0.01" name="pesohtml" required><br><br>

    <label>País (Código ISO de 3 letras):</label>
    <input type="text" name="paishtml" placeholder="Ej: ARG" required><br><br>
    
    <button type="submit">Guardar Atleta</button>
</form>
</div>
<% if (typeof error !== 'undefined') {%>
    <%= error %>

<% } %>
