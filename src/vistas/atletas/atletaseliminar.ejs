<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <title>Olimpiadas</title>
</head>
<body>

<div class="contenedor">
        <img src="/img/i.png" class="banner">
        <h1 class="tituloInicio">Eliminar Atletas</h1>
        <a href="/"><img src="/img/LogoOli.png" alt="Logo de las Olimpiadas" class="logo"></a>


        <form action="/atletas/atletaseliminar" method="post" class="formulario">
            <label for="id">ID del Atleta a eliminar:</label>
            <input type="text" id="id" name="idhtml" required>
            <button type="submit">Eliminar</button>
        </form>

<a href="/atletas">Volver a atletas</a>

<% if (typeof error !== 'undefined') {%>
    <%= error %>

<% } %>