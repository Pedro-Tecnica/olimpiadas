<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <title>Olimpiadas</title>
</head>
<body>

    <div class="contenedor">
        <img src="/img/i.png" class="banner">
        <h1 class="tituloInicio">Todos Los Atletas</h1>
        <a href="/"><img src="/img/LogoOli.png" alt="Logo de las Olimpiadas" class="logo"></a>


<h2>Atletas con más de un Oro en la misma Edición</h2>

<table border="1">
    <thead>
        <tr>
            <th>Atleta</th>
            <th>Edición</th>
            <th>Cantidad de Oros</th>
        </tr>
    </thead>
    <tbody>
        <% for (const fila of registros) { %>
            <tr>
                <td><%= fila.atleta %></td>
                <td><%= fila.edicion %></td>
                <td><%= fila.cantidad_oros %></td>
            </tr>
        <% } %>
    </tbody>
</table>

<br>
<a href="/atletas/consultas">Volver a consultas</a>