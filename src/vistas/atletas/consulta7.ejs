<h2>Atletas con Medalla de Oro</h2>

<table border="1">
    <thead>
        <tr>
            <th>Atleta</th>
            <th>Año (Edición)</th>
            <th>Evento</th>
        </tr>
    </thead>
    <tbody>
        <% for (const fila of registros) { %>
            <tr>
                <td><%= fila.atleta %></td>
                <td><%= fila.anio %></td>
                <td><%= fila.evento %></td>
            </tr>
        <% } %>
    </tbody>
</table>

<br>
<a href="/atletas/consultas">Volver a consultas</a>