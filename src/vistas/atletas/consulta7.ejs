<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <title>Olimpiadas</title>
</head>
<body>

<div class="contenedor">
        <img src="/img/i.png" class="banner">
        <h1 class="tituloInicio">Atletas</h1>
        <a href="/"><img src="/img/LogoOli.png" alt="Logo de las Olimpiadas" class="logo"></a>


<h2>Atletas con Medalla de Oro</h2>

<div class="tabla">
<table border="1">
    <thead>
        <tr>
            <th>Atleta</th>
            <th>Año (Edición)</th>
            <th>Evento</th>
        </tr>
    </thead>
    <tbody>
        <% for (const fila of registros) { %>
            <tr>
                <td><%= fila.atleta %></td>
                <td><%= fila.anio %></td>
                <td><%= fila.evento %></td>
            </tr>
        <% } %>
    </tbody>
</table>
</div>
<br>
<a href="/atletas/consultas">Volver a consultas</a>