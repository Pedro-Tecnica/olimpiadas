<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <title>Olimpiadas</title>
</head>
<body>

<div class="contenedor">
        <img src="/img/i.png" class="banner">
        <h1 class="tituloInicio">Añadir Paises</h1>
        <a href="/"><img src="/img/LogoOli.png" alt="Logo de las Olimpiadas" class="logo"></a>


<h1>Alta de paises</h1>
<a href="/paises">Volver a paises</a>

<br><br>

<form action="/paises/paisesaltas" method="POST">
    <label>País (Código ISO de 3 letras):</label>
    <input type="text" name="isohtml" placeholder="Ej: ARG" required><br><br>

    <label>Nombre:</label>
    <input type="text" name="nomhtml" required><br><br>

    <label>Continente:</label>
    <input type="text" name="continentehtml" required><br><br>

    
    <button type="submit">Guardar País</button>
</form>