<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <title>Olimpiadas</title>
</head>
<body>

<div class="contenedor">
        <img src="/img/i.png" class="banner">
        <h1 class="tituloInicio">Eliminar Deportes</h1>
        <a href="/"><img src="/img/LogoOli.png" alt="Logo de las Olimpiadas" class="logo"></a>


        <form action="/deportes/deporteseliminar" method="post" class="formulario">
            <label for="id">ID del Deporte a eliminar:</label>
            <input type="text" id="id" name="idhtml" required>
            <button type="submit">Eliminar</button>
        </form>
        
        <a href="/deportes"><img src="/img/deportes.png" alt="Volver" class="mostrarT"></a><p>Volver a Deportes</p>
</div>

</body>

<% if (typeof error !== 'undefined') {%>
    <%= error %>

<% } %>