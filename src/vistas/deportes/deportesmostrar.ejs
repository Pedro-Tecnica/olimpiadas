<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <title>Olimpiadas</title>
</head>
<body>

    <div class="contenedor">
        <img src="/img/i.png" class="banner">
        <h1 class="tituloInicio">Todos Los Deportes</h1>
        <a href="/"><img src="/img/LogoOli.png" alt="Logo de las Olimpiadas" class="logo"></a>



<h1>Deportes registrados</h1>

<div class="tabla">
    <table border="1">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
        </tr>
    </thead>
    <tbody>
        <% for (const deporte of registros) { %>
            <tr>
                <td><%= deporte.idDeportes %></td>
                <td><%= deporte.nombre %></td>
            </tr>
        <% } %>
    </tbody>
    </table>
</div>

<br>
<a href="/deportes">Volver a deportes</a>