<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <title>Olimpiadas</title>
</head>
<body>

    <div class="contenedor">
       <img src="/img/i.png" class="banner">
       <h1 class="tituloInicio">Modificar Deportes</h1>
        <a href="/"><img src="/img/LogoOli.png" alt="Logo de las Olimpiadas" class="logo"></a>


<h1>Modificar Deporte</h1>
<a href="/deportes">Volver a deportes</a><br><br>
<div class="formu">
<form action="/deportes/modificar" method="POST">
    <label>ID del Deporte a modificar:</label>
    <input type="number" name="idhtml" required><br><br>

    <label>Nuevo Nombre:</label>
    <input type="text" name="nombrehtml" required><br><br>

    <button type="submit">Modificar Deporte</button>
</form>
</div>

<% if (typeof error !== 'undefined') {%>
    <%= error %>

<% } %>