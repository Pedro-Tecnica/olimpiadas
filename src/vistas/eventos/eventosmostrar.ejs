<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <title>Olimpiadas</title>
</head>
<body>

<div class="contenedor">
        <img src="/img/i.png" class="banner">
        <h1 class="tituloInicio">Atletas</h1>
        <a href="/"><img src="/img/LogoOli.png" alt="Logo de las Olimpiadas" class="logo"></a>


<h1>Eventos Registrados</h1>

<table border="1">
    <thead>
        <tr>
            <th>ID</th>
            <th>Evento</th>
            <th>Deporte</th>
        </tr>
    </thead>
    <tbody>
        <% for (const evento of registros) { %>
            <tr>
                <td><%= evento.idEventos %></td>
                <td><%= evento.nombre %></td>
                <td><%= evento.deporte %></td>
            </tr>
        <% } %>
    </tbody>
</table>

<br>
<a href="/eventos">Volver a eventos</a>