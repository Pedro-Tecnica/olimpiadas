<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <title>Olimpiadas</title>
</head>
<body>

<div class="contenedor">
        <img src="/img/i.png" class="banner">
        <h1 class="tituloInicio">Modificar Eventos</h1>
        <a href="/"><img src="/img/LogoOli.png" alt="Logo de las Olimpiadas" class="logo"></a>


<h1>Modificar Evento</h1>
<a href="/eventos">Volver a eventos</a><br><br>

<form action="/eventos/modificar" method="POST">
    <label>ID del Evento a modificar:</label>
    <input type="number" name="idhtml" required><br><br>

    <label>Nuevo Nombre del Evento:</label>
    <input type="text" name="nombrehtml" required><br><br>

    <label>Nuevo ID del Deporte:</label>
    <input type="number" name="deportehtml" required><br><br>

    <button type="submit">Modificar Evento</button>
</form>