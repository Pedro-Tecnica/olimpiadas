<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <title>Olimpiadas</title>
</head>
<body>

<div class="contenedor">
        <img src="/img/i.png" class="banner">
        <h1 class="tituloInicio">Añadir Eventos</h1>
        <a href="/"><img src="/img/LogoOli.png" alt="Logo de las Olimpiadas" class="logo"></a>


<h1>Alta de Eventos</h1>
<a href="/eventos">Volver a eventos</a>
<br><br>

<form action="/eventos/altasalta" method="POST">
    <label>ID del Evento:</label>
    <input type="number" name="idhtml" required><br><br>

    <label>Nombre del Evento (ej: 100m Libres):</label>
    <input type="text" name="nombrehtml" required><br><br>

    <label>ID del Deporte al que pertenece:</label>
    <input type="number" name="deportehtml" required><br><br>

    <button type="submit">Guardar Evento</button>
</form>